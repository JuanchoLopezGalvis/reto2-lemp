# /etc/nginx/sites-available/sitio2
server {
    listen 80;
    server_name sitio2.local;
    access_log /var/log/nginx/sitio2.access.log lemp;
    # Forzar HTTPS
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name sitio2.local;

    root /var/www/sitio2;
    index index.php index.html;

    ssl_certificate     /etc/nginx/ssl/sitios.crt;
    ssl_certificate_key /etc/nginx/ssl/sitios.key;

    access_log /var/log/nginx/sitio2.access.log lemp;
    error_log  /var/log/nginx/sitio2.error.log warn;

    include snippets/seguridad-sitio.conf;

    location / {
        try_files $uri $uri/ =404;
    }

    location ~ \.php$ {
        include snippets/fastcgi-php.conf;
        # Pool PHP-FPM exclusivo de este sitio (usuario de sistema www-sitio2)
        fastcgi_pass unix:/run/php/php8.5-fpm-sitio2.sock;
    }
}
